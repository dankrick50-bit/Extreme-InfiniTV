<?xml version="1.0" encoding="utf-8"?>
<!-- Player controls for TVs and tablets: what is playing along the top, the time bar, and one
     row beneath it (volume on the left, transport in the middle, subtitles / audio / settings on
     the right). Every control is reachable with a D-pad; VideoActivity wires the order. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_video_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="24dp">

        <TextView
            android:id="@+id/tv_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_video_live_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/xt_video_live"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_controller_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/xt_row_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <TextClock
            android:id="@+id/tv_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#D9FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/tv_time_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@id/exo_position"
                style="@style/ExoStyledControls.TimeText.Position"
                android:textSize="15sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_video_bar_focus"
                app:bar_height="4dp"
                app:touch_target_height="40dp"
                app:scrubber_enabled_size="14dp"
                app:scrubber_dragged_size="20dp"
                app:played_color="@color/xt_accent"
                app:scrubber_color="#FFFFFFFF"
                app:buffered_color="#73FFFFFF"
                app:unplayed_color="#33FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/ExoStyledControls.TimeText.Duration"
                android:textSize="15sp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/tv_volume_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <ImageButton
                    android:id="@+id/tv_mute_button"
                    style="@style/ExoStyledControls.Button.Bottom"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="@drawable/bg_video_button"
                    android:stateListAnimator="@animator/video_control_focus"
                    android:src="@drawable/ic_video_volume"
                    android:contentDescription="@string/xt_video_mute_description" />

                <SeekBar
                    android:id="@+id/tv_volume_seekbar"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:focusable="true"
                    android:background="@drawable/bg_video_control_focus"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#FFFFFFFF"
                    android:thumbTint="#FFFFFFFF"
                    android:contentDescription="@string/xt_video_volume_description" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_transport_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <ImageButton
                    android:id="@+id/tv_channel_down"
                    style="@style/ExoStyledControls.Button.Bottom"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="14dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="@drawable/bg_video_button"
                    android:stateListAnimator="@animator/video_control_focus"
                    android:src="@drawable/ic_video_channel_down"
                    android:contentDescription="@string/xt_video_previous_channel_description"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@id/exo_rew"
                    style="@style/ExoStyledControls.Button.Center"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_video_button"
                    android:stateListAnimator="@animator/video_control_focus"
                    android:src="@drawable/ic_video_replay_10"
                    android:contentDescription="@string/exo_controls_rewind_description" />

                <ImageButton
                    android:id="@id/exo_play_pause"
                    style="@style/ExoStyledControls.Button.Center.PlayPause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_video_play"
                    android:stateListAnimator="@animator/video_play_focus"
                    android:tint="@color/video_play_icon" />

                <ImageButton
                    android:id="@id/exo_ffwd"
                    style="@style/ExoStyledControls.Button.Center"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_video_button"
                    android:stateListAnimator="@animator/video_control_focus"
                    android:src="@drawable/ic_video_forward_10"
                    android:contentDescription="@string/exo_controls_fastforward_description" />

                <ImageButton
                    android:id="@+id/tv_channel_up"
                    style="@style/ExoStyledControls.Button.Bottom"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="@drawable/bg_video_button"
                    android:stateListAnimator="@animator/video_control_focus"
                    android:src="@drawable/ic_video_channel_up"
                    android:contentDescription="@string/xt_video_next_channel_description"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_options_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <ImageButton
                    android:id="@id/exo_subtitle"
                    style="@style/ExoStyledControls.Button.Bottom.CC"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="@drawable/bg_video_button"
                    android:stateListAnimator="@animator/video_control_focus" />

                <ImageButton
                    android:id="@id/exo_audio_track"
                    style="@style/ExoStyledControls.Button.Bottom.AudioTrack"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="@drawable/bg_video_button"
                    android:stateListAnimator="@animator/video_control_focus" />

                <ImageButton
                    android:id="@id/exo_settings"
                    style="@style/ExoStyledControls.Button.Bottom.Settings"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:background="@drawable/bg_video_button"
                    android:stateListAnimator="@animator/video_control_focus" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</merge>
