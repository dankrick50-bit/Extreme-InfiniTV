<?xml version="1.0" encoding="utf-8"?>
<!-- Player controls for narrow screens (phones): three stacked rows, all reachable with a D-pad.
     Wider screens use the one-row version in layout-w600dp. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_video_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_video_live_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/xt_video_live"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_controller_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/xt_row_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="6" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/tv_volume_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/tv_mute_button"
                style="@style/ExoStyledControls.Button.Bottom"
                android:focusable="true"
                android:background="@drawable/bg_video_button"
                android:src="@drawable/ic_video_volume"
                android:contentDescription="@string/xt_video_mute_description" />

            <SeekBar
                android:id="@+id/tv_volume_seekbar"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:focusable="true"
                android:background="@drawable/bg_video_control_focus"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/xt_accent"
                android:thumbTint="@color/xt_accent"
                android:contentDescription="@string/xt_video_volume_description" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@id/exo_subtitle"
                style="@style/ExoStyledControls.Button.Bottom.CC"
                android:focusable="true"
                android:background="@drawable/bg_video_button" />

            <ImageButton
                android:id="@id/exo_audio_track"
                style="@style/ExoStyledControls.Button.Bottom.AudioTrack"
                android:focusable="true"
                android:background="@drawable/bg_video_button" />

            <ImageButton
                android:id="@id/exo_settings"
                style="@style/ExoStyledControls.Button.Bottom.Settings"
                android:focusable="true"
                android:background="@drawable/bg_video_button" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tv_time_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@id/exo_position"
                style="@style/ExoStyledControls.TimeText.Position" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_video_bar_focus"
                app:bar_height="4dp"
                app:touch_target_height="40dp"
                app:scrubber_enabled_size="14dp"
                app:scrubber_dragged_size="20dp"
                app:played_color="@color/xt_accent"
                app:scrubber_color="#FFFFFFFF"
                app:buffered_color="#73FFFFFF"
                app:unplayed_color="#33FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/ExoStyledControls.TimeText.Duration" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tv_transport_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/tv_channel_down"
                style="@style/ExoStyledControls.Button.Bottom"
                android:focusable="true"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_video_button"
                android:src="@drawable/ic_video_channel_down"
                android:contentDescription="@string/xt_video_previous_channel_description"
                android:visibility="gone" />

            <ImageButton
                android:id="@id/exo_rew"
                style="@style/ExoStyledControls.Button.Center"
                android:background="@drawable/bg_video_button"
                android:scaleType="fitCenter"
                android:padding="@dimen/exo_icon_padding"
                android:src="@drawable/ic_video_replay_10"
                android:contentDescription="@string/exo_controls_rewind_description" />

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/ExoStyledControls.Button.Center.PlayPause"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_video_play"
                android:tint="@color/video_play_icon" />

            <ImageButton
                android:id="@id/exo_ffwd"
                style="@style/ExoStyledControls.Button.Center"
                android:background="@drawable/bg_video_button"
                android:scaleType="fitCenter"
                android:padding="@dimen/exo_icon_padding"
                android:src="@drawable/ic_video_forward_10"
                android:contentDescription="@string/exo_controls_fastforward_description" />

            <ImageButton
                android:id="@+id/tv_channel_up"
                style="@style/ExoStyledControls.Button.Bottom"
                android:focusable="true"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_video_button"
                android:src="@drawable/ic_video_channel_up"
                android:contentDescription="@string/xt_video_next_channel_description"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</merge>
